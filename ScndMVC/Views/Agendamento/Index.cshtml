
@{
    @using ScndMVC.Models.Enums
    @model IEnumerable<ScndMVC.Models.Agendamento>;
    ViewData["Title"] = "Agendamento do dia: " + Model.First().DtDia.ToString("dd/MM/yyyy");
}
<br />
<h2>@ViewData["Title"]</h2>
<br /> 

<p>
    <button class="btn btn-secondary" onclick="abrirModalAgendamentoExtra()">Criar Agendamento Extra</button>
    <button class="btn btn-secondary" onclick="abrirModalAgendamentoFuturo()">Agendar para outro dia</button>
</p>

<table class="table table-striped table-hover">
    <thread>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HrAgendamento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NmCliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Servico.NmServico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>

            </th>
        </tr>
    </thread>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="status-@item.Stats">
                <td>
                    @item.HrAgendamento.ToString(@"hh\:mm")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NmCliente)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Servico.NmServico)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Valor)
                </td>
                <td>
                    @if( item.Stats.Equals(Status.Aberto) ){
                        <button class="btn btn-primary" onclick="abrirModalAgendamento(@item.ID)">Agendar</button>
                    }
                    else if ( item.Stats.Equals(Status.Agendado) ){
                        <a onclick="abrirModalFinalizarAgendamento(@item.ID)" class="btn btn-success">Confirmar</a>
                        <a onclick="confirmarExclusao(@item.ID)" class="btn btn-danger">Cancelar</a>
                    }
                    else {
                        <a onclick="verDetalhes(@item.ID)" class="btn btn-info">Ver detalhes</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



<script>
    function verDetalhes(id) {
        $.get(`/Agendamento/SelecionarAgendamento/${id}`, function (dto) {
            const agendamento = dto.agendamento;
            const servicos = dto.servicos;
            let status = "";
            switch(agendamento.stats.toString())
                {
                    case "1":
                        status = "Agendado"
                        break;
                    case "2":
                        status = "Realizado"
                        break;
                    case "3":
                        status = "Cancelado"
                        break;
                    default:
                        status = "ERRO"
                }
            Swal.fire({
                title: 'Detalhes do agendamento',
                html:
                    `
                    <dl class="d1-horizontal">
                        <dt>
                            Dia
                        </dt>
                        <dd>
                            ${(() => {
                                const partes = agendamento.dtDia.split('T')[0].split('-'); // ["yyyy", "mm", "dd"]
                                return `${partes[2]}/${partes[1]}/${partes[0]}`; // "dd/mm/yyyy"
                            })()}
                        </dd>
                        <dt>
                            Horário
                        </dt>
                        <dd>
                            ${agendamento.hrAgendamento.hours.toString().padStart(2, '0')}:${agendamento.hrAgendamento.minutes.toString().padStart(2, '0')}
                        </dd>
                        <dt>
                            Nome Cliente
                        </dt>
                        <dd>
                            ${agendamento.nmCliente}
                        </dd>
                        <dt>
                            Nome do serviço
                        </dt>
                        <dd>
                            ${servicos[agendamento.servico.id].nmServico}
                        </dd>
                        <dt>
                            Descrição
                        </dt>
                        <dd>
                            ${servicos[agendamento.servico.id].dsServico}
                            
                        </dd>
                        <dt>
                            Valor
                        </dt>
                        <dd>
                            ${agendamento.valor}
                        </dd>
                        <dt>
                            Status
                        </dt>
                        <dd>
                            ${status}
                        </dd>
                    </dl>
                    `,
                showCancelButton: true,
                cancelButtonText: 'Voltar'
            });
        });
    }

    function confirmarExclusao(id) {
        Swal.fire({
            title: 'Realmente deseja cancelar este agendamento?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sim',
            cancelButtonText: 'Não'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Agendamento/Cancelar/' + id;
            }
        });
    }

    function abrirModalAgendamento(id) {
        $.get(`/Agendamento/SelecionarAgendamento/${id}`, function (dto) {
            const agendamento = dto.agendamento;
            const servicos = dto.servicos;

            // Cria a lista de opções HTML
            let selectHtml = `<select id="Servico" class="swal2-input" style="width:100%;margin-top:10px;">`;
            servicos.forEach(s => {
                const selected = s.id === dto.servicoSelecionado ? 'selected' : '';
                selectHtml += `<option value="${s.id}" ${selected}>${s.nmServico}</option>`;
            });
            selectHtml += `</select>`;

            Swal.fire({
                title: 'Criar agendamento',
                html:
                    `<div class="form-group">
                        <label class="control-label" style="display: flex; flex-direction: column;"> Dia </label>
                        <input id="DtDia" type="date" class="swal2-input" value="${agendamento.dtDia.split('T')[0]}" readonly>
                     </div>
                     <br>
                     <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Horário </label>
                        <input id="HrAgendamento" type="time" class="swal2-input" value="${agendamento.hrAgendamento.hours.toString().padStart(2, '0')}:${agendamento.hrAgendamento.minutes.toString().padStart(2, '0')}" readonly>
                    </div>
                    <br>
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Nome Cliente </label>
                        <input id="NmCliente" type="text" class="swal2-input" value="">
                    </div>
                    <br>
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label" style="display: flex; flex-direction: column;"> Serviço </label>
                         ${selectHtml}
                    </div>
                    <br>
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Valor do serviço </label>
                        <input id="Valor" type="number" class="swal2-input" value="${agendamento.valor}">
                    </div>
                    <br>
                     `,
                    focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Salvar',
                didOpen: () => {
                    // Crie um mapa de id do serviço para valor
                    const servicoValores = {};
                    servicos.forEach(s => servicoValores[s.id] = s.valor);

                    // Atualize o valor ao trocar o serviço
                    $('#Servico').on('change', function () {
                        const servicoId = $(this).val();
                        $('#Valor').val(servicoValores[servicoId] || '');
                    });

                    // Opcional: já preenche o valor do serviço selecionado inicialmente
                    const servicoInicial = $('#Servico').val();
                    $('#Valor').val(servicoValores[servicoInicial] || '');
                },
                preConfirm: () => {
                    return {
                        agendamentoID: agendamento.id,
                        nmCliente: $('#NmCliente').val(),
                        valor: parseFloat($('#Valor').val().replace(',', '.')),
                        servicoID: parseInt($('#Servico').val())
                    };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Agendamento/Agendar',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(result.value),
                        success: function () {
                            Swal.fire('Atualizado!', 'Agendamento salvo com sucesso.', 'success')
                                .then(() => location.reload());
                        },
                        error: function () {
                            Swal.fire('Erro!', 'Erro ao salvar agendamento.', 'error');
                        }
                    });
                }
            });
        });
    }


    function abrirModalFinalizarAgendamento(id) {
        $.get(`/Agendamento/SelecionarAgendamento/${id}`, function (dto) {
            debugger
            const agendamento = dto.agendamento;

            // Cria a lista de opções HTML
            Swal.fire({
                title: 'Confirmar realização do serviço',
                html:
                    `
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Valor final pago no serviço: </label>
                        <input id="Valor" type="number" class="swal2-input" value="${agendamento.valor}">
                    </div>
                    <br>
                    `,
                    focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Finalizar',
                preConfirm: () => {
                    return {
                        agendamentoID: agendamento.id,
                        nmCliente: "",
                        valor: parseFloat($('#Valor').val().replace(',', '.')),
                        servicoID: null
                    };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Agendamento/Finalizar',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(result.value),
                        success: function () {
                            Swal.fire('Atualizado!', 'Agendamento Fiznalizado.', 'success')
                                .then(() => location.reload());
                        },
                        error: function () {
                            Swal.fire('Erro!', 'Erro ao finalizar agendamento.', 'error');
                        }
                    });
                }
            });
        });
    }

    function abrirModalAgendamentoExtra() {
        $.get(`/Agendamento/GerarAgendamentoExtra`, function (dto) {
            const agendamento = dto.agendamento;
            const servicos = dto.servicos;
            const data = agendamento.dtDia.split('T')[0]

            // Cria a lista de opções HTML
            let selectHtml = `<select id="Servico" class="swal2-input" style="width:100%;margin-top:10px;">`;
            servicos.forEach(s => {
                const selected = s.id === dto.servicoSelecionado ? 'selected' : '';
                selectHtml += `<option value="${s.id}" ${selected}>${s.nmServico}</option>`;
            });
            selectHtml += `</select>`;

            Swal.fire({
                title: `Agendamento extra`,
                html:
                    `
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Horário </label>
                        <input id="HrAgendamento" type="time" class="swal2-input" value="">
                    </div>
                    <br>
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Nome Cliente </label>
                        <input id="NmCliente" type="text" class="swal2-input" value="">
                    </div>
                    <br>
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label" style="display: flex; flex-direction: column;"> Serviço </label>
                        ${selectHtml}
                    </div>
                    <br>
                    <div class="form-group" style="display: flex; flex-direction: column;">
                        <label class="control-label"> Valor do serviço </label>
                        <input id="Valor" type="number" class="swal2-input" value="">
                    </div>
                    <br>
                    `,
                    focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Salvar',
                didOpen: () => {
                    // Crie um mapa de id do serviço para valor
                    const servicoValores = {};
                    servicos.forEach(s => servicoValores[s.id] = s.valor);

                    // Atualize o valor ao trocar o serviço
                    $('#Servico').on('change', function () {
                        const servicoId = $(this).val();
                        $('#Valor').val(servicoValores[servicoId] || '');
                    });

                    // Opcional: já preenche o valor do serviço selecionado inicialmente
                    const servicoInicial = $('#Servico').val();
                    $('#Valor').val(servicoValores[servicoInicial] || '');
                },
                preConfirm: () => {
                    dto.agendamento.id = 0;
                    dto.agendamento.hrAgendamento = $('#HrAgendamento').val();
                    dto.agendamento.nmCliente = $('#NmCliente').val();
                    dto.agendamento.valor = parseFloat($('#Valor').val());
                    delete dto.agendamento.stats;
                    dto.servicoSelecionado = parseInt($('#Servico').val())
                    dto.agendamento.servico = dto.servicos[dto.servicoSelecionado - 1]
                    
                    debugger
                    return dto;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Agendamento/AgendarExtra',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(result.value),
                        success: function () {
                            Swal.fire('Atualizado!', 'Agendamento salvo com sucesso.', 'success')
                                .then(() => location.reload());
                        },
                        error: function () {
                            Swal.fire('Erro!', 'Erro ao salvar agendamento.', 'error');
                        }
                    });
                }
            });
        });
    }

</script>

<style>
    .status-Realizado {
        --bs-table-bg: #214324 !important;
    }

    .status-Cancelado {
        --bs-table-bg: #431F1F !important;
    }
</style>