@{
    @model ScndMVC.Models.Servico;
    ViewData["Title"] = "Editando serviço: " + Model.NmServico;
}

<h2>@ViewData["Title"]</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="NmServico" class="control-label"></label>
                <input asp-for="NmServico" class="form-control" />
                <span asp-validation-for="NmServico" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="DsServico" class="control-label"></label>
                <input asp-for="DsServico" class="form-control" />
                <span asp-validation-for="DsServico" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Valor" class="control-label"></label>
                <input asp-for="Valor" class="form-control" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>
            <br />

            <div style="margin-top: 7px" class="form-group">
                <a asp-action="Index" class="btn btn-light">Voltar</a>
                <input type="submit" value="Salvar mudanças" class="btn btn-default" />
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
