
@{
    @model ScndMVC.Models.ViewModels.LoginViewModel;
}

<form asp-action="Login">
    <div class="row">
        <div asp-validation-summary="All" class="text-danger"> </div>
        <div class="col-sm-4 col-sm-offset-4 text-left">
            <label asp-for="Login" class="control-label"></label>
            <input asp-for="Login" class="form-control" placeholder="inserir login"/>
        </div>
    </div>
    <br/>
    <div class="row">
        <div class="col-sm-4 col-sm-offset-4 text-left">
            <label asp-for="Senha" class="control-label"></label>
            <input asp-for="Senha" class="form-control" />
        </div>
    </div>
    <br/>
    <div class="row">
        <div style="margin-top: 7px" class="form-group">
            <input type="submit" value="Login" class="btn btn-default" />
            @if (ViewBag.Erro != null)
            {
                <span class="alert alert-danger">@ViewBag.Erro</span>
            }
        </div>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    document.addEventListener("DOMContentLoaded", function() {
        $(".alert").delay(5000).fadeOut(1000);
    });
</script>